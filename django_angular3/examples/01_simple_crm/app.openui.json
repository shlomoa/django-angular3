{
  "id": "root",
  "version": "0.11.0",
  "type": "Application",
  "children": [
    {
      "id": "appRouting",
      "type": "Routing",
      "children": [
        {
          "id": "customersRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"customers\"",
            "uses.target": "\"customersPage\""
          }
        },
        {
          "id": "productsRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"products\"",
            "uses.target": "\"productsPage\""
          }
        }
      ]
    },
    {
      "id": "customersPage",
      "type": "DashboardPage"
    },
    {
      "id": "productsPage",
      "type": "DashboardPage"
    }
  ]
}
