{
  "ngOpenApiGen": {
    "serviceSuffix": "Api",
    "modelIndex": true
  },
  "drfSpectacular": {
    "settings": {
      "TITLE": "Example API",
      "VERSION": "1.0.0",
      "SERVE_INCLUDE_SCHEMA": false
    }
  },
  "oasdiff": {
    "format": "json"
  },
  "angular": {
    "workspace": {
      "packageManager": "pnpm",
      "style": "css",
      "routing": true
    },
    "application": {
      "ssr": false,
      "zoneless": true
    },
    "build": {
      "configuration": "production"
    }
  },
  "tool": {
    "executables": {
      "node": "node",
      "pnpm": "pnpm",
      "ng": "ng"
    }
  }
}