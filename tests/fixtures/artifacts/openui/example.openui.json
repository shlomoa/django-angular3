{
  "id": "root",
  "version": "0.11.0",
  "type": "Application",
  "children": [
    {
      "id": "appRouting",
      "type": "Routing",
      "attrs": {
        "uses.defaultRoute": "\"dashboardRoute\""
      },
      "children": [
        {
          "id": "dashboardRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"dashboard\"",
            "uses.target": "\"dashboardPage\""
          }
        },
        {
          "id": "inviteUserRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"users/invite\"",
            "uses.target": "\"inviteUserForm\""
          }
        }
      ]
    },
    {
      "id": "dashboardPage",
      "type": "DashboardPage"
    },
    {
      "id": "inviteUserForm",
      "type": "Form",
      "attrs": {
        "title": "\"Invite user\"",
        "behaves.submit": "createUser(form.value)"
      },
      "children": [
        {
          "id": "emailField",
          "type": "TextInputs",
          "attrs": {
            "uses.label": "\"Email\"",
            "uses.required": true
          }
        },
        {
          "id": "submitButton",
          "type": "ToolAction",
          "attrs": {
            "uses.label": "\"Invite\"",
            "produces.activate": "createUser(form.value)"
          }
        }
      ]
    }
  ]
}
